# Google OAuth (Google Cloud Console에서 발급)
# Authorized redirect URI로 http://localhost:3000/api/auth/callback 등록 필요
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# 세션 시크릿 (긴 랜덤 문자열 — 발급: openssl rand -hex 32)
SESSION_SECRET=

# OAuth 허용 도메인 (학교 도메인)
ALLOWED_EMAIL_DOMAIN=hafs.hs.kr

# 관리자 이메일 (쉼표로 구분 — 도메인 제한 없이 로그인 허용)
ADMIN_EMAILS=admin@example.com

# 콜백 URL (Google Cloud Console에 등록된 거랑 일치해야 함)
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# SMTP User (이메일 발송)
SMTP_USER=noreply@example.com

# SMTP Password
SMTP_PASS=

# Slack Incoming Webhook (프로덕션에서만 true로 설정)
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
APP_BASE_URL=http://printer.hafs.hs.kr

# 선택: Docker Compose는 /app/data로 자동 지정합니다.
# DATABASE_URL=sqlite+aiosqlite:///../data/db.sqlite
# UPLOAD_DIR=../data/uploads
# BOARD_UPLOAD_DIR=../data/board
